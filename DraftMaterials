from dataclasses import dataclass, field

@dataclass(frozen=True)
class Steel:
    # Identity
      standard: str  
      specification: str
  
    # Required properties (SI units in the field comment)
    density: float            # kg/m^3
    youngs_modulus: float     # GPa
    yield_strength: float     # MPa
    poissons_ratio: float     # dimensionless

    # Optional metadata
    source: str = ""
    notes: str = ""

    def __post_init__(self):
        # Validation runs once, right after the object is created
        if self.density <= 0:
            raise ValueError(f"{self.name}: density must be positive")
        if self.youngs_modulus <= 0:
            raise ValueError(f"{self.name}: Young's modulus must be positive")
        if self.yield_strength <= 0:
            raise ValueError(f"{self.name}: yield strength must be positive")
        if not 0 < self.poissons_ratio < 0.5:
            raise ValueError(f"{self.name}: Poisson's ratio must be between 0 and 0.5")

